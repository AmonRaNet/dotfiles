#! /bin/bash
set -e

if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    THIS=${BASH_SOURCE[0]}
    echo "Convert keywords to font-glyph (Powerline Font) (stdin -> stdout)"
    echo "Examples here: https://glyphsearch.com/"
    echo "---------------------"
    echo "Usage: $THIS"
    exit
fi

ICONS=( "OUT:"
        "IN:"
        "CPU:"
        "TIME:"
        "DATE:"
        "NUM:"
        "CAPS:"
        "NETWORK:"
        "WIFI:"
        "SOUND:♪"
        "MUTE:"
        "LAYOUT:"
        "HOME:"
        "MEMORY:"
        "DISK:"
        "SWAP:"
        "MONITOR:"
      )

if [ ! "$#" -eq 0 ]; then
  echo "$@" | ./$0
  exit
fi

while IFS= read -r line; do
  for icon in "${ICONS[@]}"; do
    KEY="${icon%%:*}"
    VALUE="${icon##*:}"
    line="$(echo "$line" | sed "s/\b${KEY}\b/${VALUE}/g")"
  done
  echo "$line"
done
