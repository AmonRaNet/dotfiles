#! /bin/bash
set -e

if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    THIS=${BASH_SOURCE[0]}
    ACTIONS=$(grep -E -o "\s+[a-zA-Z\-]+\)" $THIS)
    ACTIONS=$(echo "$ACTIONS" | sed -e 's/[\*\)]//g')
    echo "Run application action"
    echo "---------------------"
    echo "Usage: $THIS <action>"
    echo "where action:"
    echo "$ACTIONS"
    exit
fi

case "$1" in
        select-active)
            detach rofi -show window -show-icons
            ;;
        select-any)
            detach rofi -show combi -combi-modi drun,run -modi combi -show-icons
            ;;
        browser)
            detach gnome-www-browser
            ;;
        email)
            detach thunderbird -mail
            ;;
        player)
            detach spotify
            ;;
        calculator)
            detach gnome-calculator
            ;;
        calendar)
            detach gnome-calendar
            ;;
        home)
            detach xdg-open ~
            ;;
        search)
            detach gnome-open "http://google.com"
            ;;
        system-monitor)
            detach gnome-system-monitor
            ;;
        backlight-up)
            xbacklight -inc 20
            ;;
        backlight-down)
            xbacklight -dec 20
            ;;
        audio-volume-up)
            pactl set-sink-volume @DEFAULT_SINK@ +5%
            exec pkill -SIGRTMIN+10 i3blocks
            ;;
        audio-volume-down)
            pactl set-sink-volume @DEFAULT_SINK@ -5%
            exec pkill -SIGRTMIN+10 i3blocks
            ;;
        audio-volume-mute)
            pactl set-sink-mute @DEFAULT_SINK@ toggle
            exec pkill -SIGRTMIN+10 i3blocks
            ;;
        audio-play)
            if (playerctl -l 2>&1 | grep -i -q "no players");then
                detach spotify
                sleep 3
            fi
            playerctl play-pause
            ;;
        audio-pause)
            playerctl play-pause
            ;;
        audio-next)
            playerctl next
            ;;
        audio-prev)
            playerctl previous
            ;;
        *)
            echo "Unexpected arg $0"
            exit 1
esac
